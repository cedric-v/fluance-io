---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml">
{%- for page in collections.all -%}
  {%- if page.url -%}
    {%- if page.url != "/sitemap.xml" and page.url != "/404.html" and page.url != "/" -%}
      {%- set isNoIndex = false -%}
      {%- if page.data.robots and "noindex" in page.data.robots -%}
        {%- set isNoIndex = true -%}
      {%- endif -%}
      {%- set isExcludedFromSitemap = page.data.excludeFromSitemap
        or page.data.redirectTo
        or page.url.startsWith("/emails/")
        or page.url.startsWith("/assets/")
        or page.url.startsWith("/admin/")
        or page.url.startsWith("/membre/")
        or page.url.startsWith("/agent/")
        or page.url.startsWith("/.well-known/")
        or page.url.startsWith("/connexion")
        or page.url.startsWith("/creer-compte")
        or page.url.startsWith("/reinitialiser-mot-de-passe")
        or page.url.startsWith("/en/reset-password") -%}
      {%- if not page.url.endsWith(".js") and not page.url.endsWith(".css") and not page.url.endsWith(".xml") and not isNoIndex and not page.data.eleventyExcludeFromCollections and not isExcludedFromSitemap -%}
        {%- set cleanUrl = page.url | replace("/fluance-io", "") -%}
        {%- set fullUrl = "https://fluance.io" + cleanUrl -%}
        {%- if page.date -%}
          {%- set lastmod = page.date | date("YYYY-MM-DD") -%}
        {%- else -%}
          {%- set lastmod = "now" | date("YYYY-MM-DD") -%}
        {%- endif -%}
        {%- set changefreq = "monthly" -%}
        {%- set priority = "0.6" -%}
        {%- if cleanUrl == "/fr/" or cleanUrl == "/en/" -%}
          {%- set changefreq = "weekly" -%}
          {%- set priority = "1.0" -%}
        {%- elif "/a-propos/" in cleanUrl -%}
          {%- set priority = "0.8" -%}
        {%- endif -%}
  <url>
    <loc>{{ fullUrl }}</loc>
    <lastmod>{{ lastmod }}</lastmod>
    <changefreq>{{ changefreq }}</changefreq>
    <priority>{{ priority }}</priority>
        {%- if page.data.translationAvailable != false -%}
          {%- set frUrl = cleanUrl -%}
          {%- set enUrl = cleanUrl -%}
          {%- if cleanUrl == "/en/" -%}
            {%- set frUrl = "/fr/" -%}
          {%- elif cleanUrl.startsWith("/en/") -%}
            {%- set frUrl = cleanUrl | replace("/en/", "/") -%}
          {%- elif cleanUrl == "/fr/" -%}
            {%- set enUrl = "/en/" -%}
          {%- elif page.data.locale == "fr" -%}
            {%- set enUrl = "/en" + cleanUrl -%}
          {%- endif -%}
          {%- if page.data.translation -%}
            {%- if page.data.locale == "fr" -%}
              {%- set enUrl = page.data.translation -%}
            {%- else -%}
              {%- set frUrl = page.data.translation -%}
            {%- endif -%}
          {%- endif -%}
    <xhtml:link rel="alternate" hreflang="fr" href="https://fluance.io{{ frUrl }}" />
    <xhtml:link rel="alternate" hreflang="en" href="https://fluance.io{{ enUrl }}" />
    <xhtml:link rel="alternate" hreflang="x-default" href="https://fluance.io{{ frUrl }}" />
        {%- endif -%}
  </url>
        {%- endif -%}
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}
</urlset>
