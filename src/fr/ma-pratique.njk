---
layout: base.njk
title: Ma pratique
description: Choisissez comment vous vous sentez et lancez une pratique Fluance courte et adaptée, en quelques minutes.
locale: fr
permalink: /ma-pratique/
robots: noindex, nofollow
eleventyExcludeFromCollections: true
manifest: /ma-pratique.webmanifest
appTitle: Ma pratique
---

<section
  id="companion-app"
  class="max-w-3xl mx-auto px-4 md:px-6 py-8 md:py-12"
  data-login-url="/connexion-membre/?return=/ma-pratique/"
  data-upsell-url="/decouvrir-ma-pratique/#formules"
  data-sw-url="/sw.js?v={{ version }}"
>
  <header class="text-center mb-8 md:mb-10">
    <p class="cta-pill bg-fluance/10 text-fluance mb-4">Fluance · Ma pratique</p>
    <h1 class="text-2xl sm:text-3xl md:text-4xl font-semibold text-[#3E3A35] mb-3">Comment te sens-tu aujourd’hui ?</h1>
    <p class="text-[#3E3A35]/70 max-w-xl mx-auto">
      Choisis ce dont tu as besoin maintenant. Fluance te propose une pratique courte — 5 minutes suffisent souvent.
    </p>
  </header>

  <!-- Chargement de la session (état confirmé par Firebase) -->
  <div id="companion-auth-pending" class="hidden bg-gray-50 border border-gray-200 rounded-lg p-8 text-center">
    <div class="inline-flex items-center gap-3 text-gray-500">
      <svg class="animate-spin h-5 w-5 text-fluance" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
      </svg>
      <span class="text-sm font-medium">Chargement de ta pratique…</span>
    </div>
  </div>

  <!-- Non connecté : inscription gratuite (freemium) -->
  <div id="companion-auth-required" class="hidden section-card bg-white p-6 md:p-8">
    <h2 class="text-xl font-semibold text-[#3E3A35] mb-2">Commence gratuitement</h2>
    <p class="text-[#3E3A35]/70 mb-5 text-sm">
      Crée ton compte gratuit pour accéder à une sélection de pratiques. Aucun engagement.
    </p>
    <form id="free-signup-form" class="space-y-3 text-left" novalidate>
      <input
        type="text"
        id="signup-firstname"
        name="firstName"
        placeholder="Prénom"
        autocomplete="given-name"
        class="w-full px-4 py-3 border border-fluance/20 rounded-lg focus:ring-2 focus:ring-fluance focus:border-fluance text-[#3E3A35]"
      >
      <input
        type="email"
        id="signup-email"
        name="email"
        placeholder="Email"
        autocomplete="email"
        required
        class="w-full px-4 py-3 border border-fluance/20 rounded-lg focus:ring-2 focus:ring-fluance focus:border-fluance text-[#3E3A35]"
      >
      <input
        type="password"
        id="signup-password"
        name="password"
        placeholder="Mot de passe (min. 6 caractères)"
        autocomplete="new-password"
        minlength="6"
        required
        class="w-full px-4 py-3 border border-fluance/20 rounded-lg focus:ring-2 focus:ring-fluance focus:border-fluance text-[#3E3A35]"
      >
      <div id="companion-turnstile" class="min-h-[65px]"></div>
      <p id="free-signup-error" class="hidden text-sm text-red-700" role="alert"></p>
      <button type="submit" id="free-signup-submit" class="btn-primary !text-[#7A1F3D] bg-[#E6B84A] hover:bg-[#E8C15A] w-full">
        Créer mon compte gratuit
      </button>
    </form>
    <p class="text-sm text-[#3E3A35]/70 mt-4">
      Déjà un compte ?
      <a href="/connexion-membre/?return=/ma-pratique/" class="text-fluance font-medium hover:underline">Se connecter</a>
    </p>
  </div>

  <!-- Application -->
  <div id="companion-main" class="hidden">
    <div id="need-grid" class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-8" role="group" aria-label="Choisir un besoin">
      {% for need in practices.needs %}
      <button
        type="button"
        data-need="{{ need.id }}"
        aria-pressed="false"
        class="flex items-center gap-3 text-left px-4 py-4 rounded-xl border border-fluance/15 bg-white hover:bg-fluance/5 transition-colors"
      >
        <span class="text-2xl" aria-hidden="true">{{ need.icon }}</span>
        <span class="font-semibold text-[#3E3A35]">{{ need.label[locale] }}</span>
      </button>
      {% endfor %}
    </div>

    <section id="recommendation" class="hidden" aria-live="polite">
      <h2 id="recommendation-title" class="text-lg font-semibold text-[#3E3A35] mb-4"></h2>
      <div id="recommendation-list" class="grid grid-cols-1 md:grid-cols-2 gap-4"></div>
    </section>

    <!-- Mon suivi : statistiques, favoris, historique, rappels -->
    <section id="companion-tracking" class="hidden mt-10 pt-8 border-t border-gray-200">
      <h2 class="text-lg font-semibold text-[#3E3A35] mb-4">Mon suivi</h2>
      <div id="companion-stats" class="grid grid-cols-3 gap-3 mb-6"></div>
      <div id="companion-favorites" class="mb-6"></div>
      <div id="companion-history" class="mb-6"></div>
      <div id="companion-notifications"></div>
    </section>

    <section id="player-section" class="hidden mt-8" aria-live="polite">
      <div class="section-card bg-white p-5 md:p-6">
        <div class="flex items-center justify-between gap-4 mb-4">
          <h2 id="player-title" class="text-xl font-semibold text-[#3E3A35]">Ta pratique</h2>
          <div class="flex items-center gap-3">
            <button type="button" id="player-favorite" class="text-2xl leading-none text-[#E6B84A] hover:opacity-80" aria-pressed="false" aria-label="Ajouter aux favoris">☆</button>
            <button type="button" id="player-close" class="text-sm text-gray-500 hover:text-fluance underline">Fermer</button>
          </div>
        </div>
        <div id="player-container" class="rounded-lg overflow-hidden bg-gray-100"></div>
        <div id="player-feedback" class="hidden mt-4 text-center text-[#5a7d2a] font-medium" role="status"></div>
        <div class="mt-5 flex flex-col sm:flex-row gap-3 sm:justify-end">
          <button type="button" id="player-done" class="btn-primary !text-[#7A1F3D] bg-[#E6B84A] hover:bg-[#E8C15A]">J’ai pratiqué</button>
        </div>
      </div>
    </section>
  </div>
</section>

<script type="application/json" id="practice-catalog">{{ practices | practiceCatalog | safe }}</script>
<script type="module" src="/assets/js/firebase-auth.mjs?v={{ version }}"></script>
<script type="module" src="/assets/js/practice-companion.mjs?v={{ version }}"></script>
