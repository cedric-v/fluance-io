{%- set testimonialsData = testimonials.testimonials -%}
{%- set currentLocale = locale | default('fr') -%}

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mt-8">
  {%- for testimonial in testimonialsData -%}
    <article class="flex flex-col h-full rounded-2xl border border-fluance/15 bg-white p-6 shadow-[0_12px_30px_rgba(15,23,42,0.07)] transition-shadow duration-200 hover:shadow-[0_18px_38px_rgba(15,23,42,0.12)]">
      <header class="flex items-start justify-between gap-4 mb-5">
        <div>
          <p class="font-semibold text-[#3E3A35]">{{ testimonial.author }}</p>
        </div>
        <span class="text-3xl leading-none text-[#E6B84A]/70" aria-hidden="true">“</span>
      </header>
      <blockquote class="flex-1 text-[0.95rem] leading-relaxed text-[#3E3A35] italic">
        {{ testimonial.text[currentLocale] }}
      </blockquote>
    </article>
  {%- endfor -%}
</div>
