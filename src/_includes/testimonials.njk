{%- set testimonialsData = testimonials.testimonials -%}
{%- set currentLocale = locale | default('fr') -%}
{%- set testimonialsAuthor = testimonialsAuthor | default('') -%}

<div class="grid grid-cols-1 gap-6 mt-8{% if testimonialsAuthor %} max-w-xl mx-auto{% else %} md:grid-cols-2 lg:grid-cols-3{% endif %}">
  {%- for testimonial in testimonialsData -%}
    {%- if not testimonialsAuthor or testimonial.author == testimonialsAuthor %}
    <article class="flex flex-col h-full rounded-2xl border border-fluance/15 bg-white p-6 shadow-[0_12px_30px_rgba(15,23,42,0.07)] transition-shadow duration-200 hover:shadow-[0_18px_38px_rgba(15,23,42,0.12)]">
      <header class="flex items-start justify-between gap-4 mb-3">
        <div>
          <p class="font-semibold text-[#3E3A35]">{{ testimonial.author }}</p>
        </div>
        <span class="text-3xl leading-none text-[#E6B84A]/70" aria-hidden="true">“</span>
      </header>
      {%- if testimonial.rating %}
        <p class="mb-3 text-sm tracking-wide text-[#E6B84A]" aria-label="{{ testimonial.rating }} / 5">
          {%- for i in range(1, 6) -%}
            <span aria-hidden="true">{{ '★' if i <= testimonial.rating else '☆' }}</span>
          {%- endfor -%}
        </p>
      {%- endif %}
      <blockquote class="flex-1 text-[0.95rem] leading-relaxed text-[#3E3A35] italic">
        {{ testimonial.text[currentLocale] }}
      </blockquote>
      <footer class="mt-5 flex items-center gap-2 text-xs text-[#3E3A35]/55">
        {%- if testimonial.google %}
          <svg class="h-4 w-4 shrink-0" viewBox="0 0 48 48" aria-hidden="true">
            <path fill="#FFC107" d="M43.611 20.083H42V20H24v8h11.303c-1.649 4.657-6.08 8-11.303 8-6.627 0-12-5.373-12-12s5.373-12 12-12c3.059 0 5.842 1.154 7.961 3.039l5.657-5.657C34.046 6.053 29.268 4 24 4 12.955 4 4 12.955 4 24s8.955 20 20 20 20-8.955 20-20c0-1.341-.138-2.65-.389-3.917z"/>
            <path fill="#FF3D00" d="M6.306 14.691l6.571 4.819C14.655 15.108 18.961 12 24 12c3.059 0 5.842 1.154 7.961 3.039l5.657-5.657C34.046 6.053 29.268 4 24 4 16.318 4 9.656 8.337 6.306 14.691z"/>
            <path fill="#4CAF50" d="M24 44c5.166 0 9.86-1.977 13.409-5.192l-6.19-5.238C29.211 35.091 26.715 36 24 36c-5.202 0-9.619-3.317-11.283-7.946l-6.522 5.025C9.505 39.556 16.227 44 24 44z"/>
            <path fill="#1976D2" d="M43.611 20.083H42V20H24v8h11.303c-.792 2.237-2.231 4.166-4.087 5.571l.003-.002 6.19 5.238C36.971 39.205 44 34 44 24c0-1.341-.138-2.65-.389-3.917z"/>
          </svg>
        {%- endif %}
        <span>{{ testimonial.source[currentLocale] }}</span>
      </footer>
    </article>
    {%- endif -%}
  {%- endfor -%}
</div>
