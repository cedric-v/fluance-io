{
  "name": "fluance-io",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "npm-run-all --parallel dev:*",
    "dev:11ty": "cross-env ELEVENTY_ENV=dev eleventy --serve",
    "dev:css": "mkdir -p _site/assets/css && npx postcss ./src/assets/css/styles.css -o ./_site/assets/css/styles.css --watch",
    "build": "cross-env ELEVENTY_ENV=prod npm-run-all build:css build:11ty build:js build:cf",
    "prebuild": "npm-run-all validate validate:api",
    "validate": "node scripts/validate-frontmatter.mjs",
    "validate:api": "node scripts/validate-api-contract.mjs",
    "test:worker": "npm --prefix cloudflare/api-proxy test",
    "build:11ty": "eleventy",
    "build:cf": "node scripts/generate-cf-config.mjs",
    "build:css": "cross-env NODE_ENV=production npx postcss ./src/assets/css/styles.css -o ./_site/assets/css/styles.css",
    "build:js": "terser src/assets/js/booking.js -c -m --ecma 2020 -o _site/assets/js/booking.js",
    "build:email-templates": "node scripts/build-email-templates.js"
  },
  "keywords": [],
  "author": "Instants Zen Sàrl / Fluance",
  "license": "UNLICENSED",
  "private": true,
  "description": "",
  "dependencies": {
    "@11ty/eleventy": "^3.1.5",
    "@11ty/eleventy-img": "^7.0.0",
    "@google-cloud/firestore": "^9.0.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "eleventy-plugin-i18n": "^0.1.3",
    "eleventy-plugin-seo": "^0.5.2",
    "firebase-admin": "^14.2.0",
    "npm-run-all2": "^9.0.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "html-minifier-next": "^8.0.0",
    "mjml": "^5.3.0",
    "postcss": "^8.5.26",
    "postcss-cli": "^12.0.0",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4.3.0"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.5",
    "@tootallnate/once": "3.0.1",
    "@protobufjs/utf8": "1.1.2",
    "brace-expansion@1": "1.1.21",
    "brace-expansion@2": "2.1.7",
    "brace-expansion@5": "5.0.12",
    "fast-xml-builder": "1.3.1",
    "fast-xml-parser": "5.11.2",
    "liquidjs": "10.30.0",
    "markdown-it": "14.3.2",
    "protobufjs": "8.8.0",
    "sharp": "0.35.5",
    "uuid": "14.0.2",
    "ws": "8.22.0",
    "yaml": "2.9.1"
  }
}
