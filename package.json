{
  "name": "fluance-io",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "npm-run-all --parallel dev:*",
    "dev:11ty": "cross-env ELEVENTY_ENV=dev eleventy --serve",
    "dev:css": "mkdir -p _site/assets/css && npx postcss ./src/assets/css/styles.css -o ./_site/assets/css/styles.css --watch",
    "build": "cross-env ELEVENTY_ENV=prod npm-run-all build:css build:11ty build:cf",
    "prebuild": "npm run validate",
    "validate": "node scripts/validate-frontmatter.mjs",
    "build:11ty": "eleventy",
    "build:cf": "node scripts/generate-cf-config.mjs",
    "build:css": "npx postcss ./src/assets/css/styles.css -o ./_site/assets/css/styles.css --minify",
    "build:email-templates": "node scripts/build-email-templates.js"
  },
  "keywords": [],
  "author": "Instants Zen Sàrl / Fluance",
  "license": "UNLICENSED",
  "private": true,
  "description": "",
  "dependencies": {
    "@11ty/eleventy": "^3.1.5",
    "@11ty/eleventy-img": "^7.0.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "eleventy-plugin-i18n": "^0.1.3",
    "eleventy-plugin-seo": "^0.5.2",
    "@google-cloud/firestore": "^8.6.0",
    "firebase-admin": "^14.2.0",
    "npm-run-all2": "^9.0.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "autoprefixer": "^10.5.0",
    "html-minifier-next": "^7.5.3",
    "mjml": "^5.3.0",
    "postcss": "^8.5.26",
    "postcss-cli": "^11.0.1",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4.3.0"
  },
  "overrides": {
    "@tootallnate/once": "3.0.1",
    "@protobufjs/utf8": "1.1.2",
    "fast-xml-builder": "1.3.1",
    "fast-xml-parser": "5.11.0",
    "liquidjs": "10.29.0",
    "protobufjs": "7.6.5",
    "sharp": "0.35.3",
    "uuid": "11.1.1",
    "ws": "8.21.3",
    "yaml": "2.9.0"
  }
}
