rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Règles pour les tokens d'inscription
    match /registrationTokens/{tokenId} {
      // Seuls les utilisateurs authentifiés peuvent lire leur propre token
      // Les tokens sont vérifiés côté serveur (Firebase Functions)
      allow read: if false; // Les tokens ne doivent jamais être lus côté client
      allow write: if false; // Seules les Firebase Functions peuvent écrire
    }

    // Règles pour les utilisateurs
    match /users/{userId} {
      // Un utilisateur peut lire son propre document
      // 🔒 Pas d'écriture côté client : l'auto-octroi de produits était
      // possible via update (products[]) — les écritures passent
      // uniquement par les Firebase Functions (Admin SDK).
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update, delete: if false; // Géré par les Functions
    }

    // Règles pour le contenu protégé (stocké dans Firestore)
    match /protectedContent/{contentId} {
      // 🔒 Lecture INTERDITE côté client : tout utilisateur authentifié
      // pouvait lire tout le contenu payant (les vérifications de produit
      // et de progression étaient uniquement côté client).
      // Le contenu est servi uniquement par la fonction callable
      // getProtectedContent, qui vérifie les droits AVANT de renvoyer
      // le contenu.
      allow read: if false;
      allow write: if false; // Seules les Firebase Functions peuvent écrire
    }

    // Règles pour les commentaires
    // Structure: comments/{pageId}/messages/{messageId}
    match /comments/{pageId} {
      // Permettre la lecture des pages de commentaires
      allow read: if true;
      
      // Règles pour les messages (sous-collection)
      match /messages/{messageId} {
        // Lecture publique des commentaires
        allow read: if true;
        // Écriture autorisée sans authentification (commentaires publics avec nom)
        // Les commentaires sont modérés par validation du contenu côté client
        allow create: if request.resource.data.keys().hasAll(['name', 'text', 'timestamp'])
                      && request.resource.data.name is string
                      && request.resource.data.text is string
                      && request.resource.data.name.size() > 0
                      && request.resource.data.text.size() > 0;
        // Pas de modification ni suppression (commentaires immuables)
        allow update, delete: if false;
      }
    }

    // Tokens de réinitialisation de mot de passe
    match /passwordResetTokens/{tokenId} {
      // 🔒 Lecture interdite côté client : les tokens sont vérifiés
      // uniquement par les Firebase Functions (verifyPasswordResetToken
      // / checkPasswordResetToken). L'ancienne règle (allow read: if true)
      // exposait email + expiration à quiconque connaissait l'ID du token.
      allow read: if false;
      // Écriture uniquement par les fonctions Firebase (via Admin SDK)
      allow write: if false;
    }

    // Toutes les autres collections sont refusées par défaut
    match /{document=**} {
      allow read, write: if false;
    }
  }
}



